{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "EDUFIX: run website and API",
      "type": "coreclr",
      "request": "launch",
      "program": "${workspaceFolder}\\server\\EDUFIX.Api\\bin\\Debug\\net10.0\\Edufix.Api.dll",
      "cwd": "${workspaceFolder}\\server\\EDUFIX.Api",
      "preLaunchTask": "EDUFIX: build API",
      "stopAtEntry": false,
      "console": "integratedTerminal",
      "env": {
        "ASPNETCORE_ENVIRONMENT": "Development",
        "ASPNETCORE_URLS": "https://localhost:7180;http://localhost:5180"
      },
      "serverReadyAction": {
        "action": "openExternally",
        "pattern": "\\bNow listening on:\\s+(https?://\\S+)"
      }
    }
  ]
}
